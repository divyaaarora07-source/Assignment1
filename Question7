using System;

class Factorial
{
    static void Main()
    {
        int num;
        long fact = 1;

        // Input a number
        Console.Write("Enter a positive integer: ");
        num = Convert.ToInt32(Console.ReadLine());

        // Calculate factorial
        if (num < 0)
        {
            Console.WriteLine("Factorial is not defined for negative numbers.");
        }
        else
        {
            for (int i = 1; i <= num; i++)
            {
                fact = fact * i;
            }

            Console.WriteLine("Factorial of " + num + " = " + fact);
        }

        Console.ReadLine();
    }
}
