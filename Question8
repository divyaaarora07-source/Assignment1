using System;

class PrimeNumber
{
    static void Main()
    {
        int num;
        bool isPrime = true;

        // Input a number
        Console.Write("Enter a number: ");
        num = Convert.ToInt32(Console.ReadLine());

        // Check prime number
        if (num <= 1)
        {
            isPrime = false;
        }
        else
        {
            for (int i = 2; i <= num / 2; i++)
            {
                if (num % i == 0)
                {
                    isPrime = false;
                    break;
                }
            }
        }

        // Display result
        if (isPrime)
        {
            Console.WriteLine(num + " is a Prime Number.");
        }
        else
        {
            Console.WriteLine(num + " is Not a Prime Number.");
        }

        Console.ReadLine();
    }
}
