using System;

class EvenOdd
{
    static void Main()
    {
        int n;

        // Input N
        Console.Write("Enter the value of N: ");
        n = Convert.ToInt32(Console.ReadLine());

        // Print even numbers
        Console.WriteLine("\nEven Numbers:");
        for (int i = 1; i <= n; i++)
        {
            if (i % 2 == 0)
            {
                Console.Write(i + " ");
            }
        }

        // Print odd numbers
        Console.WriteLine("\n\nOdd Numbers:");
        for (int i = 1; i <= n; i++)
        {
            if (i % 2 != 0)
            {
                Console.Write(i + " ");
            }
        }

        Console.ReadLine();
    }
}
